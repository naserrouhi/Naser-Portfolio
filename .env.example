# Used by the Next.js server when running outside Docker.
API_INTERNAL_URL=http://localhost:5100

# Replace this with the production canonical URL before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional HTML-token verification for Google Search Console. DNS verification
# is also supported and does not require this value.
GOOGLE_SITE_VERIFICATION=

# Optional ISO-8601 timestamp used for main-page sitemap entries. Leave it
# empty unless it represents a truthful significant content update.
SITE_LAST_MODIFIED=

# Public browser origin accepted by the API container.
CORS_ALLOWED_ORIGIN=http://localhost:3000
